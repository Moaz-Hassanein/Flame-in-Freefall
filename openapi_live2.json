{
  "components": {
    "schemas": {
      "AnswerStatus": {
        "description": "Status of the pipeline response.",
        "enum": [
          "answered",
          "insufficient_evidence",
          "out_of_scope",
          "clarification_needed",
          "error"
        ],
        "title": "AnswerStatus",
        "type": "string"
      },
      "AskRequest": {
        "additionalProperties": false,
        "description": "Request body for the /ask endpoint.",
        "properties": {
          "question": {
            "description": "Natural-language question about microgravity combustion experiments.",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "additionalProperties": false,
        "description": "Full pipeline response for a natural-language question.\n\nProduced by ask() after planning, retrieval, generation, and guardrails.",
        "properties": {
          "aggregates": {
            "description": "Computed aggregate results (AggregateResult dumps) with exclusion counts.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Aggregates",
            "type": "array"
          },
          "answer_markdown": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Grounded markdown answer with inline [EXP-ID] citation markers.",
            "title": "Answer Markdown"
          },
          "citations": {
            "description": "Verified citations for every experiment_id referenced in the answer.",
            "items": {
              "$ref": "#/components/schemas/CitationRecord"
            },
            "title": "Citations",
            "type": "array"
          },
          "dataset_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "First 8 chars of the Parquet SHA256 for data provenance tracing.",
            "title": "Dataset Version"
          },
          "evidence": {
            "description": "Capped evidence rows passed to the LLM (experiment_id, key fields, etc.).",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Evidence",
            "type": "array"
          },
          "limitations": {
            "description": "Limitations the user must be aware of (exclusions, caps, caveats).",
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "plan": {
            "additionalProperties": true,
            "description": "The interpreted QueryPlan echoed back for transparency.",
            "title": "Plan",
            "type": "object"
          },
          "question": {
            "description": "The original natural-language question.",
            "title": "Question",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AnswerStatus",
            "description": "Pipeline outcome status."
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Wall-clock seconds for each pipeline stage (plan_s, retrieval_s, etc.).",
            "title": "Timings",
            "type": "object"
          },
          "warnings": {
            "description": "Non-fatal warnings raised during retrieval or guardrails.",
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "question",
          "status"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "CitationRecord": {
        "additionalProperties": false,
        "description": "A verified citation linking an inline marker to an experiment record.",
        "properties": {
          "dataset_family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Dataset family the experiment belongs to.",
            "title": "Dataset Family"
          },
          "experiment_id": {
            "description": "Unique experiment identifier.",
            "title": "Experiment Id",
            "type": "string"
          },
          "investigation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Investigation or campaign identifier.",
            "title": "Investigation Id"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "URL of the original data source.",
            "title": "Source Url"
          }
        },
        "required": [
          "experiment_id"
        ],
        "title": "CitationRecord",
        "type": "object"
      },
      "DatasetVersionInfo": {
        "additionalProperties": false,
        "description": "Dataset version and provenance information loaded from the manifest.",
        "properties": {
          "canonical_legacy_rows": {
            "default": 0,
            "description": "Rows carried from legacy canonical data.",
            "title": "Canonical Legacy Rows",
            "type": "integer"
          },
          "flags": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Quality flag counts.",
            "title": "Flags",
            "type": "object"
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO timestamp of snapshot generation.",
            "title": "Generated At"
          },
          "git_commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Git commit hash when the snapshot was generated.",
            "title": "Git Commit"
          },
          "manifest_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Filesystem path of provenance manifest.",
            "title": "Manifest Path"
          },
          "parquet_path": {
            "description": "Filesystem path of the Parquet snapshot.",
            "title": "Parquet Path",
            "type": "string"
          },
          "parquet_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "SHA256 checksum of the Parquet snapshot.",
            "title": "Parquet Sha256"
          },
          "raw_rebuild_rows": {
            "default": 0,
            "description": "Rows rebuilt from raw sources.",
            "title": "Raw Rebuild Rows",
            "type": "integer"
          },
          "source_policy": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Mapping of source policies to dataset families.",
            "title": "Source Policy",
            "type": "object"
          },
          "total_rows": {
            "default": 0,
            "description": "Total rows in the snapshot.",
            "title": "Total Rows",
            "type": "integer"
          }
        },
        "required": [
          "parquet_path"
        ],
        "title": "DatasetVersionInfo",
        "type": "object"
      },
      "FieldCatalog": {
        "additionalProperties": false,
        "description": "Catalog of all fields in the trusted experiment snapshot.",
        "properties": {
          "fields": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldInfo"
            },
            "description": "Map of field name to FieldInfo.",
            "title": "Fields",
            "type": "object"
          }
        },
        "required": [
          "fields"
        ],
        "title": "FieldCatalog",
        "type": "object"
      },
      "FieldInfo": {
        "additionalProperties": false,
        "description": "Metadata and bounds for a single dataset column.",
        "properties": {
          "allowed_values": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Observed distinct non-null values for categorical columns.",
            "title": "Allowed Values"
          },
          "caveat": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Documented limitations or caveats.",
            "title": "Caveat"
          },
          "data_type": {
            "description": "Logical data type (string, float, int, boolean, date, list[str]).",
            "title": "Data Type",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Field documentation.",
            "title": "Description"
          },
          "is_canonical": {
            "description": "True if one of the 28 original canonical columns.",
            "title": "Is Canonical",
            "type": "boolean"
          },
          "is_categorical": {
            "description": "True if categorical string with bounded domain.",
            "title": "Is Categorical",
            "type": "boolean"
          },
          "is_enrichment": {
            "description": "True if an enrichment or provenance column.",
            "title": "Is Enrichment",
            "type": "boolean"
          },
          "is_numeric": {
            "description": "True if numeric (float or integer).",
            "title": "Is Numeric",
            "type": "boolean"
          },
          "max_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Maximum observed non-null value for numeric columns.",
            "title": "Max Value"
          },
          "min_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Minimum observed non-null value for numeric columns.",
            "title": "Min Value"
          },
          "name": {
            "description": "Column name.",
            "title": "Name",
            "type": "string"
          },
          "null_count": {
            "default": 0,
            "description": "Total null count in the snapshot.",
            "title": "Null Count",
            "type": "integer"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Physical unit of measurement.",
            "title": "Unit"
          }
        },
        "required": [
          "name",
          "data_type",
          "is_canonical",
          "is_enrichment",
          "is_numeric",
          "is_categorical"
        ],
        "title": "FieldInfo",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Liveness probe response.",
        "properties": {
          "status": {
            "default": "ok",
            "description": "Liveness status.",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "MetaResponse": {
        "additionalProperties": false,
        "description": "Dataset metadata, versions, and frontend display constraints.",
        "properties": {
          "data_limitations": {
            "description": "Summary of critical scientific caveats for UI display.",
            "items": {
              "type": "string"
            },
            "title": "Data Limitations",
            "type": "array"
          },
          "dataset_families": {
            "description": "Distinct dataset families present in snapshot.",
            "items": {
              "type": "string"
            },
            "title": "Dataset Families",
            "type": "array"
          },
          "field_catalog": {
            "$ref": "#/components/schemas/FieldCatalog",
            "description": "Column definitions, units, and allowed values."
          },
          "modeled_rows_count": {
            "description": "Count of rows marked with is_modeled=True.",
            "title": "Modeled Rows Count",
            "type": "integer"
          },
          "version_info": {
            "$ref": "#/components/schemas/DatasetVersionInfo",
            "description": "Provenance manifest metadata."
          }
        },
        "required": [
          "version_info",
          "field_catalog",
          "dataset_families",
          "modeled_rows_count",
          "data_limitations"
        ],
        "title": "MetaResponse",
        "type": "object"
      },
      "PaginatedExperimentsResponse": {
        "additionalProperties": false,
        "description": "Paginated listing of experiments.",
        "properties": {
          "items": {
            "description": "List of experiment records.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "description": "Pagination page size limit.",
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "description": "Pagination offset.",
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "description": "Total matching rows.",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "PaginatedExperimentsResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "additionalProperties": false,
        "description": "Readiness probe response verifying storage and LLM configuration.",
        "properties": {
          "dataset_loaded": {
            "description": "True if Parquet snapshot is readable.",
            "title": "Dataset Loaded",
            "type": "boolean"
          },
          "llm_configured": {
            "description": "True if LLM provider and API key are configured.",
            "title": "Llm Configured",
            "type": "boolean"
          },
          "manifest_loaded": {
            "description": "True if provenance manifest is loaded.",
            "title": "Manifest Loaded",
            "type": "boolean"
          },
          "status": {
            "description": "Readiness status ('ready' or 'not_ready').",
            "title": "Status",
            "type": "string"
          },
          "total_rows": {
            "description": "Total rows in the snapshot.",
            "title": "Total Rows",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "dataset_loaded",
          "manifest_loaded",
          "total_rows",
          "llm_configured"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Deterministic structured retrieval and grounded RAG API for NASA/JAXA microgravity combustion experiment data.",
    "title": "Flame in Freefall",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ask": {
      "post": {
        "description": "Process natural-language question through the RAG pipeline.",
        "operationId": "ask_question_api_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask Question",
        "tags": [
          "RAG"
        ]
      }
    },
    "/api/v1/experiments": {
      "get": {
        "description": "Filtered, paginated experiment records using QueryPlan validation.",
        "operationId": "list_experiments_api_v1_experiments_get",
        "parameters": [
          {
            "description": "Filter by dataset family.",
            "in": "query",
            "name": "dataset_family",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by dataset family.",
              "title": "Dataset Family"
            }
          },
          {
            "description": "Filter by fuel material.",
            "in": "query",
            "name": "fuel_material",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by fuel material.",
              "title": "Fuel Material"
            }
          },
          {
            "description": "Filter modeled status.",
            "in": "query",
            "name": "is_modeled",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter modeled status.",
              "title": "Is Modeled"
            }
          },
          {
            "description": "Page limit.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Page limit.",
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Page offset.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Page offset.",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedExperimentsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Experiments",
        "tags": [
          "Experiments"
        ]
      }
    },
    "/api/v1/experiments/{experiment_id}": {
      "get": {
        "description": "Retrieve full experiment record with provenance links and flags.",
        "operationId": "get_experiment_by_id_api_v1_experiments__experiment_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "experiment_id",
            "required": true,
            "schema": {
              "title": "Experiment Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Experiment By Id Api V1 Experiments  Experiment Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Experiment By Id",
        "tags": [
          "Experiments"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Liveness probe.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "Observability"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "description": "Return dataset metadata, catalog definitions, and UI constraints.",
        "operationId": "get_meta_api_v1_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Meta",
        "tags": [
          "Metadata"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "description": "Readiness probe checking snapshot accessibility and manifest.",
        "operationId": "ready_api_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "Observability"
        ]
      }
    }
  }
}