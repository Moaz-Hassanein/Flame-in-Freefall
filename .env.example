# Flame in Freefall environment template.
# Copy to .env for local use. Never commit .env or real credentials.

# Application
FLAME_APP_NAME=Flame in Freefall
FLAME_APP_VERSION=0.1.0

# Data paths (relative paths resolve against the repository root)
FLAME_DATA_RAW_DIR=data/raw
FLAME_DATA_PROCESSED_DIR=data/processed
FLAME_DATA_INTERIM_DIR=data/interim
FLAME_CANONICAL_DATASET_PATH=data/processed/canonical_experiments.csv
FLAME_DUCKDB_PATH=data/interim/flame.duckdb

# Logging: DEBUG, INFO, WARNING, ERROR, or CRITICAL
FLAME_LOG_LEVEL=INFO

# LLM placeholders. No provider, model, or key is configured by default.
# FLAME_LLM_PROVIDER=
# FLAME_LLM_MODEL=
# FLAME_LLM_API_KEY=
